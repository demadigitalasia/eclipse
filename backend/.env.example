# Salin menjadi .env dan isi nilai deployment. Jangan commit secret.
ECLIPSE_DATA_DIR=./data
ECLIPSE_DB_PATH=
# local keeps media on disk. Select r2 only after private bucket credentials are configured.
ECLIPSE_STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=eclipse
R2_PRESIGNED_URL_TTL_SECONDS=300
ECLIPSE_PORT=8000
ECLIPSE_VERSION=0.1.0-mvp1
ECLIPSE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
ECLIPSE_COOKIE_SECURE=false
ECLIPSE_ALLOW_REGISTRATION=true
ECLIPSE_RESET_CODE_LOGGING=false
# Optional SMTP delivery for password-reset codes. Configure host and sender to enable.
ECLIPSE_RESET_SMTP_HOST=
ECLIPSE_RESET_SMTP_PORT=587
ECLIPSE_RESET_SMTP_USERNAME=
ECLIPSE_RESET_SMTP_PASSWORD=
ECLIPSE_RESET_SMTP_FROM=
ECLIPSE_RESET_SMTP_STARTTLS=true
# Fallback egress proxy; override dapat dikelola admin dari panel Proxy / Egress.
ECLIPSE_EGRESS_PROXY=
LOG_LEVEL=INFO
# Keputusan B0 (8 Okt 2026)
FREE_DAILY_ANALYZE=3
FREE_DAILY_RENDER=1
FREE_RENDER_TRIAL_DAYS=3
LITE_DAILY_RENDER=15
LITE_MONTHLY_PRICE_IDR=150000
PRO_DAILY_RENDER=25
PRO_MONTHLY_PRICE_IDR=300000
MAX_BATCH_CLIPS=5
METADATA_RETENTION_DAYS=90
TEMP_FILE_TTL_HOURS=24
